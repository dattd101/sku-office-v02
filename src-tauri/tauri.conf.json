{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Office",
  "version": "0.5.1",
  "identifier": "dev.rustoffice.modern",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Rust Office Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 950,
        "minHeight": 600,
        "backgroundColor": "#f5f7fb",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "shortDescription": "Modern Rust Office desktop",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
